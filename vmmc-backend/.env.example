NODE_ENV=development
PORT=8443

# Origin of the Next.js frontend dev server (see vmmc-frontend/AGENTS.md for its $PORT)
CORS_ORIGIN=http://localhost:3000

# Supabase project — created in Phase 1. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Dedicated secret for short-lived password-reset handoff tokens — unrelated to
# Supabase's own token signing (verified via supabase.auth.getUser() instead
# of a local secret, since projects may use asymmetric ES256 signing keys).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
RESET_TOKEN_SECRET=

# Shared password for the Phase 1 demo/seed accounts (prototype only — never real PHI).
SEED_DEMO_PASSWORD=

# Email channel (Phase 7) — Brevo (brevo.com), sent over their HTTPS API, not raw SMTP.
# Raw SMTP (originally Gmail) was dropped after Railway's outbound network couldn't
# reliably reach port 587 in production (ENETUNREACH / connection timeout, confirmed
# live) — an HTTP API sidesteps that entirely. EMAIL_FROM must be a single sender
# verified in Brevo's dashboard (no domain ownership required). Left blank is safe:
# with no key, the email channel logs what it would have sent instead of calling the
# real API, so nothing incurs cost until this is filled in.
BREVO_API_KEY=
EMAIL_FROM=

# SMS channel (Phase 7) — Semaphore (semaphore.co), a PH-focused SMS gateway. Left blank
# is safe: with no key, the SMS channel logs what it would have sent instead of calling
# the real API, so nothing incurs cost until this is filled in.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
