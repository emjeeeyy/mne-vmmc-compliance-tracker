# This file covers the whole "Capstone VMMC" tree if it's ever git-init'd at this root level
# (both vmmc-backend/ and vmmc-frontend/ have their own .gitignore too — nested .gitignore files
# are additive in git, so both apply regardless of where `git init` actually happens).

# Dependencies
node_modules/

# Build output
dist/
.next/
out/
build/

# Environment files — secrets, never commit. .env.example files are intentionally NOT matched.
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/

# Playwright (e2e/) output — reports and traces are regenerated by every run, never source
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# TypeScript incremental build cache
*.tsbuildinfo

# Supabase CLI local state
supabase/.temp
supabase/.branches

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.idea/
.vscode/

# Claude Code project config — kept local-only by request, not pushed to GitHub. This means
# groupmates cloning the repo won't automatically get the permission allowlist or the
# /dev-restart, /verify custom commands from .claude/commands/ — worth knowing if that's ever
# reconsidered, since those are otherwise meant to be team-shared Claude Code conventions.
/.claude/

# The original build plan — kept local-only by request, not pushed to GitHub. docs/HANDOFF.md
# and docs/SYSTEM_ARCHITECTURE.md are the current, shared source of truth instead.
/VMMC_TBDOTS_BuildSpec.md

# Stray disposable scratch scripts (should be deleted before commit, ignored defensively)
_tmp-*
