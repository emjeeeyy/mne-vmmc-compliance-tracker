  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3"
  }
}
