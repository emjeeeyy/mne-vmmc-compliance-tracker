{
  "name": "capstone-vmmc",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm --prefix vmmc-backend run start:dev\" \"cross-env PORT=3000 npm --prefix vmmc-frontend run dev:webpack\"",
