# Base URL of the vmmc-backend API (including the /api prefix).
# Dev default points at the local NestJS server started with `npm run start:dev` in `vmmc-backend`.
# For a real deployment, point this at that backend's public URL — cloud deploy itself is out of
# scope for this build (see VMMC_TBDOTS_BuildSpec.md §Phase 12 "Excluded per scope").
NEXT_PUBLIC_API_URL=http://localhost:8443/api
