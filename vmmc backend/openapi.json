  "info": {
    "title": "VMMC TB DOTS API",
    "description": "ITIL 4 Monitoring & Event Management backend for the VMMC TB DOTS health management system. Write endpoints accept an `Idempotency-Key` header so a client retry after a timeout never duplicates a record.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string",
            "example": "VMMC-23-0002"
          },
          "password": {
            "type": "string"
          },
          "portal": {
            "type": "string",
            "enum": [
              "staff",
              "admin"
            ]
          }
        },
        "required": [
          "employeeId",
          "password",
          "portal"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "string",
            "description": "Either an email address or a PH mobile number.",
            "example": "ana.garcia@vmmc.gov.ph"
          }
        },
        "required": [
          "contact"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "string",
            "description": "Same contact used in the forgot-password request."
          },
          "otp": {
            "type": "string",
            "description": "6-digit code.",
            "example": "123456"
          }
        },
        "required": [
          "contact",
          "otp"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string",
            "description": "Short-lived token returned by /auth/verify-otp."
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "resetToken",
          "newPassword"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "UploadSignatureDto": {
        "type": "object",
        "properties": {
          "imageDataUrl": {
            "type": "string",
            "description": "Base64 PNG data URL, e.g. from canvas.toDataURL(\"image/png\")."
          }
        },
        "required": [
          "imageDataUrl"
        ]
      },
      "UpdatePinDto": {
        "type": "object",
        "properties": {
          "currentPin": {
            "type": "string",
            "description": "Required unless no PIN has ever been set on this account."
          },
          "newPin": {
            "type": "string"
          }
        },
        "required": [
          "newPin"
        ]
      },
      "UpdatePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "UpdatePrivacySettingsDto": {
        "type": "object",
        "properties": {
          "encryptRecords": {
            "type": "boolean"
          },
          "shareAnalytics": {
            "type": "boolean"
          },
          "telemetryLogging": {
            "type": "boolean"
          }
        }
      },
      "CreateDeviceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "iPhone 14 Pro"
          },
          "deviceType": {
            "type": "string",
            "example": "Mobile"
          }
        },
        "required": [
          "name"
        ]
      },
      "ReviewDocumentDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Required when action is \"reject\"."
          },
          "signatureId": {
            "type": "string",
            "description": "Required when action is \"approve\" — the admin's digital_signatures id."
          }
        },
        "required": [
          "action"
        ]
      },
      "UpsertPreEmploymentDto": {
        "type": "object",
        "properties": {
          "baselineXrayPath": {
            "type": "string",
            "description": "Storage reference for the baseline chest X-ray, if captured."
          },
          "screeningResult": {
            "type": "string",
            "description": "Free-text baseline screening result."
          },
          "fitForDuty": {
            "type": "boolean",
            "description": "Whether the employee has been cleared fit for duty."
          }
        }
      },
      "CreatePepLogDto": {
        "type": "object",
        "properties": {
          "exposureDate": {
            "type": "string",
            "example": "2026-07-01"
          },
          "exposureType": {
            "type": "string",
            "example": "Needlestick injury"
          },
          "prophylaxisStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "DECLINED"
            ],
            "default": "PENDING"
          },
          "followUpDate": {
            "type": "string",
            "example": "2026-07-14"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "exposureDate",
          "exposureType"
        ]
      },
      "UpdatePepLogDto": {
        "type": "object",
        "properties": {
          "prophylaxisStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "DECLINED"
            ]
          },
          "followUpDate": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "CreateImmunizationDto": {
        "type": "object",
        "properties": {
          "vaccineType": {
            "type": "string",
            "example": "Hepatitis B"
          },
          "dose": {
            "type": "number",
            "example": 1
          },
          "administeredDate": {
            "type": "string",
            "example": "2026-07-01"
          },
          "nextDueDate": {
            "type": "string",
            "description": "When the next dose in this series is due (drives the ~quarterly cadence)."
          },
          "quarter": {
            "type": "string",
            "example": "Q3"
          }
        },
        "required": [
          "vaccineType",
          "dose",
          "administeredDate"
        ]
      }
    }
  }
}